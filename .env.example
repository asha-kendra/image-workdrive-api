# Server
PORT=3000
HOST=http://localhost:3000

# Zoho OAuth (from https://api-console.zoho.com)
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REFRESH_TOKEN=your_refresh_token

# Zoho region — change if your account is EU/AU/IN/JP
# EU  → https://accounts.zoho.eu
# AU  → https://accounts.zoho.com.au
# IN  → https://accounts.zoho.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Zoho WorkDrive folder ID (the folder to upload images into)
# Open the folder in WorkDrive → copy the ID from the URL
ZOHO_WORKDRIVE_FOLDER_ID=your_folder_id

# WorkDrive API base — change for non-US regions if needed
# EU  → https://workdrive.zoho.eu
# AU  → https://workdrive.zoho.com.au
ZOHO_WORKDRIVE_API_URL=https://workdrive.zoho.com
